# Documentation: https://wiki.hypr.land/Hypr-Ecosystem/hyprtoolkit/

# Color specifications use hex ARGB format (0xAARRGGBB)

# Main Application Theming
background = 0x2e3440          # Base background color
base = 0x434853                 # Base color for panels/containers
accent = 0x979aa0            # Accent color for focused items, buttons, or highlights

# Typography and Scale
font_size = 11                  # Default UI font size
scale = 1.0                     # Global interface scaling factor


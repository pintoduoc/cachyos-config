<application>
  <component name="KeyPromoterXStatistic">
    <option name="statistics">
      <Statistic Action="Commit">
        <Item>
          <IdeaActionID>ActivateCommitToolWindow</IdeaActionID>
          <ShortCut>'Alt+0'</ShortCut>
          <Description>Commit</Description>
          <Count>6</Count>
        </Item>
      </Statistic>
      <Statistic Action="Copy">
        <Item>
          <IdeaActionID>$Copy</IdeaActionID>
          <ShortCut>'Ctrl+C' or 'Ctrl+Insert'</ShortCut>
          <Description>Copy</Description>
          <Count>3</Count>
        </Item>
      </Statistic>
      <Statistic Action="Copy Path">
        <Item>
          <IdeaActionID>WelcomeScreen.CopyProjectPath</IdeaActionID>
          <ShortCut>'Ctrl+Shift+C'</ShortCut>
          <Description>Copy Path</Description>
          <Count>1</Count>
        </Item>
      </Statistic>
      <Statistic Action="Hide All Windows">
        <Item>
          <IdeaActionID>HideAllWindows</IdeaActionID>
          <ShortCut>'Ctrl+Shift+F12'</ShortCut>
          <Description>Hide All Windows</Description>
          <Count>1</Count>
        </Item>
      </Statistic>
      <Statistic Action="Project">
        <Item>
          <IdeaActionID>ActivateProjectToolWindow</IdeaActionID>
          <ShortCut>'Alt+1'</ShortCut>
          <Description>Project</Description>
          <Count>18</Count>
        </Item>
      </Statistic>
      <Statistic Action="Project Structure…">
        <Item>
          <IdeaActionID>ShowProjectStructureSettings</IdeaActionID>
          <ShortCut>'Ctrl+Alt+Shift+S'</ShortCut>
          <Description>Project Structure…</Description>
          <Count>2</Count>
        </Item>
      </Statistic>
      <Statistic Action="Run">
        <Item>
          <IdeaActionID>Run</IdeaActionID>
          <ShortCut>'Shift+F10'</ShortCut>
          <Description>Run</Description>
          <Count>5</Count>
        </Item>
      </Statistic>
      <Statistic Action="Settings">
        <Item>
          <IdeaActionID>ShowSettings</IdeaActionID>
          <ShortCut>'Ctrl+Alt+S'</ShortCut>
          <Description>Settings</Description>
          <Count>2</Count>
        </Item>
      </Statistic>
      <Statistic Action="Settings…">
        <Item>
          <IdeaActionID>ShowSettings</IdeaActionID>
          <ShortCut>'Ctrl+Alt+S'</ShortCut>
          <Description>Settings…</Description>
          <Count>1</Count>
        </Item>
      </Statistic>
      <Statistic Action="Show Context Actions">
        <Item>
          <IdeaActionID>ShowIntentionActions</IdeaActionID>
          <ShortCut>'Alt+Enter'</ShortCut>
          <Description>Show Context Actions</Description>
          <Count>4</Count>
        </Item>
      </Statistic>
      <Statistic Action="Sync Maven Changes">
        <Item>
          <IdeaActionID>ExternalSystem.ProjectRefreshAction</IdeaActionID>
          <ShortCut>'Ctrl+Shift+O'</ShortCut>
          <Description>Sync Maven Changes</Description>
          <Count>2</Count>
        </Item>
      </Statistic>
    </option>
  </component>
</application>